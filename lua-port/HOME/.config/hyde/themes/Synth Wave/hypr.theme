$HOME/.config/hypr/themes/theme.lua|> $HOME/.config/hypr/themes/colors.lua
-- HyDE theme: Synth Wave
-- Lua port (Hyprland 0.56+). Deployed by HyDE to ~/.config/hypr/themes/*.lua.
local hyde = require("conf.hyde")
hyde.gsettings("gsettings set org.gnome.desktop.interface icon-theme 'BeautyLine'")
hyde.gsettings("gsettings set org.gnome.desktop.interface gtk-theme 'Synth-Wave'")
hyde.gsettings("gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'")

hl.config({
    general = {
        gaps_in = 12,
        gaps_out = 18,
        border_size = 2,
        col = {
            active_border = { colors = { "rgba(03edf9ff)", "rgba(72f1b8ff)" }, angle = 45 },
            inactive_border = { colors = { "rgba(495495cc)", "rgba(614D85cc)" }, angle = 45 },
        },
        layout = "dwindle",
        resize_on_border = true,
    },
    group = {
        col = {
            border_active = { colors = { "rgba(03edf9ff)", "rgba(72f1b8ff)" }, angle = 45 },
            border_inactive = { colors = { "rgba(495495cc)", "rgba(614D85cc)" }, angle = 45 },
            border_locked_active = { colors = { "rgba(03edf9ff)", "rgba(72f1b8ff)" }, angle = 45 },
            border_locked_inactive = { colors = { "rgba(495495cc)", "rgba(614D85cc)" }, angle = 45 },
        },
    },
    decoration = {
        rounding = 2,
        shadow = {
            enabled = true, -- was: drop_shadow = true
            scale = 1, -- was: shadow_scale = 1
            offset = "0 0", -- was: shadow_offset = 0 0
            range = 12, -- was: shadow_range = 12
            render_power = 1, -- was: shadow_render_power = 1
            color = "0xffff7edb", -- was: col.shadow = 0xffff7edb
        },
        blur = {
            enabled = true,
            size = 6,
            passes = 3,
            new_optimizations = true,
            ignore_opacity = true,
            xray = false,
        },
    },
})

hl.layer_rule({ match = { namespace = "waybar" }, blur = true }) -- was: blurls = waybar
