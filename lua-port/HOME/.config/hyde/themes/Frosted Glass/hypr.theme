$HOME/.config/hypr/themes/theme.lua|> $HOME/.config/hypr/themes/colors.lua
-- HyDE theme: Frosted Glass
-- Lua port (Hyprland 0.56+). Deployed by HyDE to ~/.config/hypr/themes/*.lua.
local hyde = require("conf.hyde")
--  ___________      _________                        __
--  \__    ___/      \_   ___ \_______ ___.__._______/  |_
--   |    |  ______ /    \  \/\_  __ <   |  |\____ \   __\
--   |    | /_____/ \     \____|  | \/\___  ||  |_> >  |
--   |____|          \______  /|__|   / ____||   __/|__|
--                          \/        \/     |__|
hyde.gsettings("gsettings set org.gnome.desktop.interface icon-theme 'Tela-circle-blue'")
hyde.gsettings("gsettings set org.gnome.desktop.interface gtk-theme 'Frosted-Glass'")
hyde.gsettings("gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'")

hl.config({
    general = {
        gaps_in = 4,
        gaps_out = 10,
        border_size = 2,
        col = {
            active_border = { colors = { "rgba(2770C0ff)", "rgba(1E4C84ff)" }, angle = 45 },
            inactive_border = { colors = { "rgba(A44185cc)", "rgba(012339cc)" }, angle = 45 },
        },
        layout = "dwindle",
        resize_on_border = true,
    },
    group = {
        col = {
            border_active = { colors = { "rgba(2770C0ff)", "rgba(1E4C84ff)" }, angle = 45 },
            border_inactive = { colors = { "rgba(A44185cc)", "rgba(012339cc)" }, angle = 45 },
            border_locked_active = { colors = { "rgba(2770C0ff)", "rgba(1E4C84ff)" }, angle = 45 },
            border_locked_inactive = { colors = { "rgba(A44185cc)", "rgba(012339cc)" }, angle = 45 },
        },
    },
    decoration = {
        rounding = 13,
        shadow = {
            enabled = false, -- was: drop_shadow = false
            offset = "0 0", -- was: shadow_offset = 0 0
            range = 15, -- was: shadow_range = 15
            render_power = 1, -- was: shadow_render_power = 1
            color = "0x80ffffff", -- was: col.shadow = 0x80ffffff
        },
        active_opacity = 0.75,
        inactive_opacity = 0.75,
        blur = {
            enabled = true,
            size = 4,
            passes = 4,
            new_optimizations = true,
            ignore_opacity = true,
            xray = false,
        },
    },
})

hl.layer_rule({ match = { namespace = "waybar" }, blur = true }) -- was: layerrule = blur,waybar
