$HOME/.config/hypr/themes/theme.lua|> $HOME/.config/hypr/themes/colors.lua
-- HyDE theme: Catppuccin Mocha
-- Lua port (Hyprland 0.56+). Deployed by HyDE to ~/.config/hypr/themes/*.lua.
local hyde = require("conf.hyde")
hyde.gsettings("gsettings set org.gnome.desktop.interface icon-theme 'Tela-circle-dracula'")
hyde.gsettings("gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Mocha'")
hyde.gsettings("gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'")

hl.config({
    general = {
        gaps_in = 3,
        gaps_out = 8,
        border_size = 2,
        col = {
            active_border = { colors = { "rgba(ca9ee6ff)", "rgba(f2d5cfff)" }, angle = 45 },
            inactive_border = { colors = { "rgba(b4befecc)", "rgba(6c7086cc)" }, angle = 45 },
        },
        layout = "dwindle",
        resize_on_border = true,
    },
    group = {
        col = {
            border_active = { colors = { "rgba(ca9ee6ff)", "rgba(f2d5cfff)" }, angle = 45 },
            border_inactive = { colors = { "rgba(b4befecc)", "rgba(6c7086cc)" }, angle = 45 },
            border_locked_active = { colors = { "rgba(ca9ee6ff)", "rgba(f2d5cfff)" }, angle = 45 },
            border_locked_inactive = { colors = { "rgba(b4befecc)", "rgba(6c7086cc)" }, angle = 45 },
        },
    },
    decoration = {
        rounding = 10,
        shadow = {
            enabled = false, -- was: drop_shadow = false
        },
        blur = {
            enabled = true,
            size = 6,
            passes = 3,
            new_optimizations = true,
            ignore_opacity = true,
            xray = false,
        },
    },
})

hl.layer_rule({ match = { namespace = "waybar" }, blur = true }) -- was: layerrule = blur,waybar
