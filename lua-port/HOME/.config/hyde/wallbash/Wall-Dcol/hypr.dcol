$HOME/.config/hypr/themes/colors.lua
-- wallbash template -> ~/.config/hypr/themes/colors.lua (<wallbash_*> placeholders are filled in by swwwallbash.sh)
-- Lua port (Hyprland 0.56+). Deployed by HyDE to ~/.config/hypr/themes/*.lua.
local hyde = require("conf.hyde")
hyde.gsettings("gsettings set org.gnome.desktop.interface gtk-theme 'Wallbash-Gtk'")
hyde.gsettings("gsettings set org.gnome.desktop.interface color-scheme 'prefer-<wallbash_mode>'")

hl.config({
    general = {
        col = {
            active_border = { colors = { "rgba(<wallbash_pry4>ff)", "rgba(<wallbash_4xa1>ff)" }, angle = 45 },
            inactive_border = { colors = { "rgba(<wallbash_pry1>ff)", "rgba(<wallbash_pry2>ff)" }, angle = 45 },
        },
    },
    group = {
        col = {
            border_active = { colors = { "rgba(<wallbash_pry4>ff)", "rgba(<wallbash_4xa1>ff)" }, angle = 45 },
            border_inactive = { colors = { "rgba(<wallbash_pry1>cc)", "rgba(<wallbash_pry2>cc)" }, angle = 45 },
            border_locked_active = { colors = { "rgba(<wallbash_txt3>ff)", "rgba(<wallbash_txt4>ff)" }, angle = 45 },
            border_locked_inactive = { colors = { "rgba(<wallbash_txt1>cc)", "rgba(<wallbash_txt2>cc)" }, angle = 45 },
        },
    },
})
